# sa-harness (local-only WebAuthn setup harness)
tools/sa-harness/.env
tools/sa-harness/.env.testnet
tools/sa-harness/fixtures.testnet.json
tools/sa-harness/fixtures.json
tools/sa-harness/.vite/
tools/sa-harness/proxy-key.pem
