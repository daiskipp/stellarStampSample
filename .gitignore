# Self-signed certs (rpc-https-proxy etc.) and local pnpm store
*.pem
.pnpm-store/

# Cloudflare Workers local secret file (apps/worker/.dev.vars). Not covered
# by the `.env` rule above. NEVER commit fee payer secrets.
apps/worker/.dev.vars
apps/worker/.wrangler/

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright E2E artifacts + one-shot pipeline runtime state
test-results/
playwright-report/
**/.last-run.json
e2e/.servers.json

# Generated Soroban TS bindings — regenerated by scripts/generate-bindings.sh
# and network-specific (embed contract IDs). Keep the hand-written aggregator
# (packages/contracts/src/index.ts) and its package.json tracked.
packages/contracts/src/visit-stamps/
packages/contracts/src/beans-token/
packages/contracts/src/benefits/
packages/contracts/src/badges/
packages/contracts/src/reward-policy/
