# customer-app E2E / smoke env override (loaded by `vite --mode test`).
#
# Restores the legacy plain-http page transport (basicSsl is disabled in
# vite.config.ts for `mode === "test"`) and points the kit's RPC at the
# external `scripts/rpc-https-proxy.mjs` (https://127.0.0.1:8443/rpc) used by
# e2e/global-setup.ts and scripts/smoke-customer-app.mjs. The rest of the
# env (contract ids, RP_ID, etc.) is inherited from `.env`.
VITE_RPC_URL=https://127.0.0.1:8443/rpc
VITE_RPC_PROXY_URL=https://127.0.0.1:8443/rpc
