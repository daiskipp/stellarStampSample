# staff-app production env template (Cloudflare Pages, Testnet).
#
# Usage:
#   1. Pick a CF Pages host (default: dicekey-staff-app.pages.dev) and
#      rename <your-host> below. If using a single host shared with
#      customer-app, both apps' RP_ID must match that host so a single
#      passkey enrolment serves both.
#   2. Run `just testnet`. The 5 contract ids and HQ Smart Account values
#      land in /.env.testnet.
#   3. `cp apps/staff-app/.env.production.example apps/staff-app/.env.production`
#      and paste from .env.testnet.
#   4. Either commit .env.production locally OR put VITE_* keys in the
#      Cloudflare Pages dashboard "Environment variables".
#
# Note on staff passkey: VITE_HQ_STAFF_CREDENTIAL_ID / VITE_HQ_STAFF_NAME
# are NOT set by `just testnet` — staff register their own passkey via
# staff-app's "Enroll device" flow on first use. The flow registers the
# new passkey as a signer on the 3 staff rules + benefits rule using the
# HQ root credential (admin context).

VITE_NETWORK=testnet
VITE_RPC_URL=https://soroban-testnet.stellar.org
# REQUIRED: apps/staff-app/.env (localnet dev) sets
# VITE_RPC_PROXY_URL=https://localhost:5174/rpc, and Vite layers .env then
# .env.production — keys missing here LEAK localnet values into the prod
# bundle. passkey.ts evaluates `VITE_RPC_PROXY_URL || VITE_RPC_URL`, so the
# proxy MUST be explicitly overridden. Testnet RPC is HTTPS so no proxy is
# needed — point both at the same URL.
VITE_RPC_PROXY_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_FRIENDBOT_URL=https://friendbot.stellar.org

# Contracts — paste from .env.testnet after `just testnet`.
VITE_VISIT_STAMPS_CONTRACT=<set after just testnet>
VITE_BEANS_TOKEN_CONTRACT=<set after just testnet>
VITE_BENEFITS_CONTRACT=<set after just testnet>
VITE_BADGES_CONTRACT=<set after just testnet>
VITE_REWARD_POLICY_CONTRACT=<set after just testnet>

# Deployer / fee payer (G-address) - paste from .env.testnet.
VITE_DEPLOYER_ADDRESS=<set after just testnet>

# OZ Testnet infra (SDF-published, stable across kit 0.2.x/main).
VITE_ACCOUNT_WASM_HASH=8537b8166c0078440a5324c12f6db48d6340d157c306a54c5ea81405abcc2611
VITE_WEBAUTHN_VERIFIER_ADDRESS=CCMR63YE5T7MPWREF3PC5XNTTGXFSB4GYUGUIT5POHP2UGCS65TBIUUU
VITE_ED25519_VERIFIER_ADDRESS=CCJOUKLCZVCXS4VIBBEA7S3SPWZQS5DPE5A4YG67RA3Z7E3SJZAUJFQA
VITE_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
VITE_THRESHOLD_POLICY_ADDRESS=CB2WQXF2XXDGUV2CTVQ23RLN3ESI3IY5KKX3KVXWBNRTTWDHZM76NVKJ
VITE_SPENDING_LIMIT_POLICY_ADDRESS=CBBZ2XP4LBDEO2EELTZKJSPQZDREFKCULL6CKIUQO53S42RZABOYQUK3
VITE_WEIGHTED_THRESHOLD_POLICY_ADDRESS=CCF65VXVORNOZBRR3EG3GZYSFS3ALDG44CDYN5T5KRWKYX6RXLKLXER4

# WebAuthn relying party. MUST equal the CF Pages host (or a registrable
# suffix of it). Staff passkeys live at this RP_ID; if you choose a host
# distinct from customer-app's, staff and customer credentials live in
# separate WebAuthn realms (each side must enrol its own passkeys).
VITE_RP_ID=<your-host>.pages.dev
VITE_RP_NAME=dicekey Coffee Stamps

# HQ Smart Account + staff rules + demo customer — paste from /.env.testnet
# after `just testnet`.
VITE_HQ_SMART_ACCOUNT=<set after just testnet>
VITE_HQ_ROOT_CREDENTIAL_ID=<set after just testnet>
VITE_HQ_STAFF_CONTEXT_RULE_ID=<set after just testnet>
VITE_HQ_STAFF_RULE_IDS=<set after just testnet>
VITE_HQ_STAFF_BENEFITS_RULE_ID=<set after just testnet>
VITE_DEMO_CUSTOMER_SA=<set after just testnet>

# Optional: kit relayer URL (CF Workers). Leave blank to submit directly to
# RPC. Staff actions are signed by staff passkeys + HQ rules; the worker
# would absorb fees so staff doesn't need XLM. Out of scope for Tier 3.
VITE_WORKER_URL=
